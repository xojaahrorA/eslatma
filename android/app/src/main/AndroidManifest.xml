<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Uyqu kuzatuvi: akselerometr yozuvi (faol sessiyada, foydalanuvchi
             "Sensor rejimi"ni o'zi yoqadi). Bildirishnoma doim ko'rinadi,
             ma'lumot faqat ilovaning ichki xotirasiga yoziladi. -->
        <service
            android:name=".SleepSensorService"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Barmoq izi / yuz bilan ochish (BiometricPrompt) — biometrik ma'lumot o'qilmaydi,
         faqat tizim dialogi chaqiriladi -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Lokal eslatmalar (bildirishnomalar) — barchasi faqat qurilmada rejalashadi -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Aniq vaqtga eslatmalar (vazifa boshlanishidan oldin) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Telefon qayta yoqilgandan keyin eslatmalarni tiklash -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Budilnik: zang chalish va tebranish uchun -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Uyqu kuzatuvi (akselerometr) Foreground Service — "health" tipi talabi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
</manifest>
